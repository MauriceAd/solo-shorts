# Copy to .env for local testing. NEVER commit a filled-in .env.
# Without these, the app runs with the in-memory test store (nothing persists).

# Cloudflare R2 — video files (free tier: 10 GB storage, zero egress)
# Get these from the Cloudflare dashboard: R2 -> Manage R2 API Tokens.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=solo-shorts
# Public URL videos play from (R2 -> your bucket -> Settings -> Public access,
# or a custom domain). Example: https://pub-<id>.r2.dev
R2_PUBLIC_BASE_URL=

# Cloudflare D1 — video records, likes, comments, owner passcode hash
# (free tier: 5 GB storage, 5M rows read/day, 100K rows written/day, no card)
# CF_ACCOUNT_ID: Cloudflare dashboard URL / account home.
# D1_DATABASE_ID: D1 -> your database -> Overview.
# CF_API_TOKEN: My Profile -> API Tokens -> Create (needs D1:Edit permission).
CF_ACCOUNT_ID=
CF_API_TOKEN=
D1_DATABASE_ID=

# Server port (Render sets PORT itself; local default is 3000)
PORT=3000
